{
  "name": "gollum-flow",
  "version": "0.2.0",
  "description": "Agent distro for long-running coding agents — Goal / Outcome / Task / Evidence / Checkpoint state layer with portable skills and tools.",
  "type": "module",
  "bin": {
    "gollum": "./dist/cli/index.js",
    "gollum-resolver": "./dist/cli/gollum-resolver.js",
    "gollum-store": "./dist/cli/gollum-store.js"
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "README.md"
  ],
  "keywords": [
    "agent-distro",
    "coding-agent",
    "claude-code",
    "codex",
    "mavis",
    "skills",
    "goal-alignment",
    "checkpoint",
    "evidence",
    "workflow"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/workflow/store/migrations && cp src/workflow/store/migrations/*.sql dist/workflow/store/migrations/ && rm -rf dist/skills && cp -r src/skills dist/skills && rm -rf dist/templates && cp -r src/templates dist/templates 2>/dev/null || true",
    "dev": "tsx src/cli/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node ./dist/hooks/postinstall.js"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
