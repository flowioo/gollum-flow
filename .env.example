# Gollum Workflow Store
# Only variables the code actually reads are listed here — a knob that nothing
# reads is worse than no knob, because it looks configurable.

# SQLite database path. Default: ~/.local/share/gollum/gollum.db
GOLLUM_DB_PATH=./data/gollum.db

# Directory holding the versioned .sql migrations.
# Default: the migrations/ dir inside the installed package.
# GOLLUM_MIGRATION_DIR=./src/workflow/store/migrations
